    Merchants ||--o{ Products : "owns"
    Merchants ||--o{ MerchantProductMapping : "offers"
    Products ||--o{ MerchantProductMapping : "mapped"

    %% علاقات Transactions
    MerchantProductMapping ||--o{ TransactionItems : "used in"
    Products ||--o{ TransactionItems : "appears in"
    Transactions ||--o{ TransactionItems : "contains"
    Transactions ||--o{ Payments : "generates"
    Payments ||--o{ Refunds : "may refund"

    %% علاقات MerchantTransactions & Ledger
    Merchants ||--o{ MerchantTransactions : "participates"
    Transactions ||--o{ MerchantTransactions : "includes"
    Transactions ||--o{ Ledger : "has ledger entries"

    %% علاقات Merchants ↔ Transactions
    Transactions ||--o{ Merchants : "involved"
    Merchants ||--o{ Merchants : "Seller"
    Merchants ||--o{ Merchants : "Buyer"

    %% علاقات Wallets
    Users ||--o{ DigitalWallets : "owns wallets"
    DigitalWallets ||--o{ WalletTransactions : "records transactions"
    Transactions ||--o{ WalletTransactions : "linked"
*/